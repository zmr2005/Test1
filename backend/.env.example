# 复制为 .env 并按需修改
PROJECT_NAME=CRM 线索管控系统
SECRET_KEY=please-change-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 数据库连接（示例为 MySQL，也可换成 postgresql://... 或 sqlite:///./crm.db）
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/crm?charset=utf8mb4

# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173
